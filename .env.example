# ========================================
# CRM 系统环境配置示例
# 部署时复制此文件为 .env 并修改配置值
# ========================================

# 后端服务配置
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# 后端服务配置（用于开发环境前端代理）
# 如果修改了 SERVER_PORT，需要同时修改此项
VITE_BACKEND_URL=http://127.0.0.1:5000

# Flask 会话密钥（生产环境请修改为随机字符串）
SECRET_KEY=crm_secret_key_2026

# LLM AI 配置（可选，不填则 AI 问答/线索抓取功能不可用）
# 推荐 DeepSeek（性价比高）：https://platform.deepseek.com 申请 API Key
LLM_API_KEY=
LLM_API_BASE=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat

# CORS 跨域配置（NAS 部署时填 NAS IP:8088，多个用逗号分隔）
# 例如：http://192.168.1.100:8088,http://nas.local:8088
CORS_ALLOWED_ORIGINS=
